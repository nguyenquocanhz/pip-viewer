{
  "manifest_version": 3,
  "name": "PiP Viewer — Xem video & ảnh trong ảnh",
  "short_name": "PiP Viewer",
  "version": "1.0.1",
  "description": "Mở video, ảnh hoặc canvas bất kỳ trong cửa sổ ảnh-trong-ảnh nổi trên mọi ứng dụng.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PiP Viewer (Alt+P)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Bật/tắt PiP cho video đang phát"
    },
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Chọn phần tử để mở PiP"
    },
    "pip-image": {
      "description": "Mở PiP cho ảnh lớn nhất trên trang"
    }
  }
}
